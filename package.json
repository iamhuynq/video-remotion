{
  "name": "video-remotion",
  "version": "1.0.0",
  "private": true,
  "description": "Data-driven vertical ranking videos built with Remotion",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "build": "remotion render src/index.ts NarutoRanking out/naruto-ranking.mp4",
    "still": "remotion still src/index.ts NarutoRanking out/preview.png --frame=120",
    "lint": "tsc --noEmit",
    "build:akatsuki": "remotion render src/index.ts AkatsukiRanking out/akatsuki-ranking.mp4",
    "still:akatsuki": "remotion still src/index.ts AkatsukiRanking out/akatsuki-preview.png --frame=120"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.7.2"
  }
}
